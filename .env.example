# ==============================================================================
# WeDate — Environment Configuration Template
# Copy this file to .env in your root or server folder before starting the server.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or local URI; leave empty or 'memory' for auto in-memory dev DB)
MONGODB_URI=mongodb://localhost:27017/wedate

# JWT Authentication
JWT_SECRET=wedate_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=wedate_cookie_secret_key_2026

# Student Community Email Domain Restriction
# Neutral configurable domain for student email validation
ALLOWED_EMAIL_DOMAIN=campus.edu

# Nodemailer / SMTP Configuration
# In development, if SMTP is not provided, Ethereal test account or local logger preview is automatically used
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="WeDate Community" <noreply@campus.edu>

# Cloudinary Media Storage (Optional in local development; local file storage fallback is active if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
